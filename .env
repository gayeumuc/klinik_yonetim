# ─── Frontend URL (e-postalardaki linkler için) ───────────────────────────────
# Geliştirme: http://localhost:3001  |  Production: https://sizin-domain.com
FRONTEND_URL=http://localhost:3001

DEBUG=True
ALLOWED_HOSTS=*

# ─── Veritabanı ───────────────────────────────────────────────────────────────
# Geliştirme: SQLite (varsayılan)
# Production için aşağıdaki satırları doldurun:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=klinik_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# ─── E-posta — Gmail SMTP ─────────────────────────────────────────────────────
# Gmail'de "Uygulama Şifresi" oluşturmak için:
#   1. Google Hesabı → Güvenlik → 2 Adımlı Doğrulama (açık olmalı)
#   2. Güvenlik → Uygulama şifreleri → "Posta" + "Windows Bilgisayar" seç
#   3. Oluşturulan 16 haneli şifreyi EMAIL_HOST_PASSWORD'a yapıştır
# ── E-posta Ayarları ──────────────────────────────────────────────────────────
# Gmail uygulama şifresi almak için:
#   1. https://myaccount.google.com/security → 2 Adımlı Doğrulama AÇIK olmalı
#   2. https://myaccount.google.com/apppasswords → Uygulama: Posta, Cihaz: Windows
#   3. Oluşturulan 16 haneli şifreyi (boşluksuz) EMAIL_HOST_PASSWORD'a yapıştır
#
# Şifre girilmemişse sistem console backend'e geçer (terminale yazar, mail atmaz)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=gayeumuc@gmail.com
EMAIL_HOST_PASSWORD=avxhhjzlnfkzyflr
DEFAULT_FROM_EMAIL=ANKA Danışmanlık <gayeumuc@gmail.com>